# CPABOOK Environment Configuration
# Copy to .env for local development
# NEVER commit .env with real values

# ── Site Identity ──
SITE_NAME="My Book Catalog"
SITE_SLUG="mybooks"
SITE_GENRE="fiction"
SITE_LANGUAGE="en"
SITE_URL="http://localhost:5173"

# ── Provider API Keys (optional — leave empty to disable) ──
# Google Books API key (optional, increases quota)
GOOGLE_BOOKS_API_KEY=""

# ── Administration ──
# Shared secret for admin API endpoints
ADMIN_API_KEY=""

# ── Cloudflare (for deployment only) ──
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_D1_DATABASE_ID=""
